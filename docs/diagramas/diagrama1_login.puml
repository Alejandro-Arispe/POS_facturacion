@startuml diagrama1_login
skinparam monochrome true
skinparam shadowing false
autonumber
actor "Usuario" as U
participant "LoginPage\n(Angular/Flutter)" as LP
participant "AuthController" as AC
participant "AuthService" as AS
participant "JwtService" as JS
participant "UsuarioRepository" as UR

U -> LP : ingresa credenciales
LP -> AC : POST /api/auth/login\n{email, password}
activate AC
AC -> AS : authenticate(email, password)
activate AS
AS -> UR : findByEmail(email)
activate UR
UR --> AS : Usuario
deactivate UR
AS -> AS : validar BCrypt password
alt credenciales inválidas
  AS --> AC : throw UnauthorizedException
  AC --> LP : 401 Unauthorized
else credenciales válidas
  AS -> JS : generateToken(usuario)
  activate JS
  JS --> AS : JWT token
  deactivate JS
  AS --> AC : AuthResponseDto\n(token, permisos, rol)
  deactivate AS
  AC --> LP : 200 OK {token, permisos}
  deactivate AC
  LP -> LP : guarda token en localStorage/SecureStorage
  LP --> U : redirige según rol\n(ADMIN→dashboard, CLIENTE→inicio)
end
@enduml
