@startuml diagrama2_venta_mixta
skinparam monochrome true
skinparam shadowing false
autonumber
actor "Cajero" as C
participant "SalesPage" as SP
participant "VentaController" as VC
participant "VentaService" as VS
participant "CreditoService" as CS
participant "SiatFacturaService" as FS
participant "VentaRepository" as VR
participant "CreditoRepository" as CR

C -> SP : agrega productos al carrito
C -> SP : selecciona pago mixto\n(efectivo + crédito)
SP -> VC : POST /api/ventas/sesiones/{id}/ventas\n{productos, pagoEfectivo, montoCreditro}
activate VC
VC -> VS : crearVenta(dto)
activate VS
VS -> VR : save(venta)
activate VR
VR --> VS : Venta persisted
deactivate VR
opt montoCredito > 0
  VS -> CS : crearCredito(venta, montoPendiente)
  activate CS
  CS -> CR : save(credito PENDIENTE)
  CR --> CS : Credito persisted
  deactivate CS
end
VS -> FS : emitirFactura(venta)
activate FS
FS --> VS : Factura emitida
deactivate FS
VS --> VC : VentaResponseDto
deactivate VS
VC --> SP : 200 OK {venta, factura, credito?}
deactivate VC
SP --> C : muestra resumen de venta
@enduml
