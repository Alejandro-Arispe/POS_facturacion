# Copia este archivo como ".env" (en la carpeta pos-backend) y completa los valores.
# El archivo .env esta en .gitignore: no se sube al repositorio.
# En Azure estas mismas variables se configuran como secretos/variables de la Container App.

# Google AI Studio (Gemini) para los reportes con IA: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar (opcional)
GEMINI_MODEL=gemini-3.5-flash

# Microservicio de analitica (Python)
ANALYTICS_URL=http://localhost:8001
ANALYTICS_API_KEY=
